# Journey Notes — what belongs in version control.
#
# The rule this file follows: track the source needed to clone the repo and run
# `npm install && npm run dev`. Everything else — build output, generated
# artefacts, editor state, licensed binaries, and local data — stays out.

# --- dependencies and build output ----------------------------------------

node_modules
dist
dist-ssr
*.local
*.tsbuildinfo
.vite/

# Generated test reports.
coverage/
test-results/
playwright-report/
blob-report/

# Tests and development-only tools stay on this machine, not in the source release.
/src/test/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
/src-tauri/local-tests/
/scripts/
/vitest.config.local.ts
/tsconfig.local-tests.json
/LOCAL_TESTING.md

# Rust build output (`target` is large; `gen` is regenerated by Tauri).
src-tauri/target
src-tauri/gen

# --- local machine state --------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
.idea
.vscode/*
!.vscode/extensions.json
*.log
*.swp
*.swo

# --- environment and signing credentials ----------------------------------

.env
.env.*
# Only sanitized templates should be committed.
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.p8
*.keystore
*.jks

# --- agent / tooling scratch ----------------------------------------------

# Per-machine assistant configuration and its generated design imagery (~12 MB
# of PNG/WebP). None of it is used at build or run time.
.impeccable/
.claude/
.cursor/
.agents/
.codex/

# --- the user's own notebook ----------------------------------------------

# The real SQLite database lives in the OS app-data directory, not here — but a
# stray copy or a manual backup must never be committed. It is personal writing.
*.sqlite
*.sqlite-*
*.sqlite.bak*
*.sqlite3
*.sqlite3-*
*.sqlite3.bak*
*.db
*.db-*
*.db.bak*

# Manual copies of app exports/backups at the repository root.
/backups/
/exports/

# One-off maintenance scripts containing this user's real notebook details.
# Keep the local copies; these are not application code or reusable examples.
/src-tauri/examples/organise_papers.rs
/src-tauri/examples/organise_positions.rs
/src-tauri/examples/unify_paper_titles.rs
/src-tauri/examples/try_search.rs

# --- licensed fonts -------------------------------------------------------

# Microsoft YaHei (微软雅黑) is proprietary. `docs/ttfs/` holds the 28 MB
# originals, and `src/assets/fonts/` the 9.8 MB subsets that `styles/fonts.css`
# loads at runtime.
#
# The subsets are excluded, so a fresh clone falls back to the system CJK face
# (PingFang SC on macOS) — the app builds and runs, only the Chinese shapes
# differ. See DEVELOPING.md for how to restore them locally.
#
# If this repository stays private and you accept the licence risk, delete the
# `src/assets/fonts/` line to get D-035's typography back.
docs/ttfs/
src/assets/fonts/

# --- large design references ----------------------------------------------

# ~9.9 MB of generated mockups. The written specs in `docs/**/*.md` are what
# actually bind implementation (AGENTS.md §3); these are the images they cite.
# Excluded to keep the clone small — remove this line if you want the visual
# record travelling with the specs.
docs/design/reference/
