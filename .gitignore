# Journey Notes — what belongs in version control.
#
# Track application source, build resources, and the root README. Internal
# documents, tests, local data, tools, and generated artifacts stay on this machine.

# --- local documentation --------------------------------------------------

*.[mM][dD]
!/README.md
/docs/

# --- dependencies and build output ----------------------------------------

node_modules
dist
dist-ssr
*.local
*.tsbuildinfo
.vite/

# Generated test reports.
coverage/
test-results/
playwright-report/
blob-report/

# Tests and development-only tools stay on this machine, not in the source release.
/src/test/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
/src-tauri/local-tests/
/scripts/
/vitest.config.local.ts
/tsconfig.local-tests.json

# Rust build output (`target` is large; `gen` is regenerated by Tauri).
src-tauri/target
src-tauri/gen

# --- local machine state --------------------------------------------------

.DS_Store
Thumbs.db
Desktop.ini
.idea
.vscode/*
!.vscode/extensions.json
*.log
*.swp
*.swo

# --- environment and signing credentials ----------------------------------

.env
.env.*
# Only sanitized templates should be committed.
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.p8
*.keystore
*.jks

# --- agent / tooling scratch ----------------------------------------------

# Per-machine assistant configuration and generated scratch assets.
.impeccable/
.claude/
.cursor/
.agents/
.codex/

# --- the user's own notebook ----------------------------------------------

# The real SQLite database lives in the OS app-data directory, not here — but a
# stray copy or a manual backup must never be committed. It is personal writing.
*.sqlite
*.sqlite-*
*.sqlite.bak*
*.sqlite3
*.sqlite3-*
*.sqlite3.bak*
*.db
*.db-*
*.db.bak*

# Manual copies of app exports/backups at the repository root.
/backups/
/exports/

# One-off maintenance scripts containing this user's real notebook details.
# Keep the local copies; these are not application code or reusable examples.
/src-tauri/examples/organise_papers.rs
/src-tauri/examples/organise_positions.rs
/src-tauri/examples/unify_paper_titles.rs
/src-tauri/examples/try_search.rs

# --- local font binaries --------------------------------------------------

# Optional proprietary CJK fonts are not distributed with the source.
# A fresh clone uses system font fallbacks; see the root README.
src/assets/fonts/
